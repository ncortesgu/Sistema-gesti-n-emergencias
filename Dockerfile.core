FROM debian:bookworm-slim AS compilacion

RUN apt-get update \
    && apt-get install -y --no-install-recommends cmake g++ make ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src

COPY CMakeLists.txt ./
COPY include ./include
COPY src ./src
COPY main.cpp ./

RUN cmake -B build -DCMAKE_BUILD_TYPE=Release \
    && cmake --build build --target servidor_emergencias -j"$(nproc)"

FROM debian:bookworm-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends libstdc++6 ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY --from=compilacion /src/build/servidor_emergencias /usr/local/bin/servidor_emergencias
COPY config ./config

ENV CPP_API_PORT=9000 \
    UNIDADES_FILE=/app/config/unidades.json

EXPOSE 9000

HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=5 \
    CMD curl -fsS http://127.0.0.1:9000/api/salud || exit 1

ENTRYPOINT ["servidor_emergencias"]
