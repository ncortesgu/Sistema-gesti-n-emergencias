# Copia este archivo como .env y ajusta lo necesario.

# Proveedor de clasificación: laya | jev | reglas
PROVEEDOR=laya

# Si un proveedor falla, usar el clasificador determinista de respaldo.
FALLBACK_REGLAS=true

# Confianza mínima para no marcar una clasificación como revisable.
CONFIANZA_MINIMA=0.55

# Umbral para agregar departamentos de apoyo.
UMBRAL_APOYO=0.55

# Laya (modelo local en Python)
LAYA_MODEL=multilingual
LAYA_DEVICE=
LAYA_PRELOAD=false
LAYA_MAX_LEN=1024

# OpenRouter / Jev
OPENROUTER_API_KEY=
JEV_MODEL=typesafe/jev-1.14

# Whisper.cpp
WHISPER_MODEL=small
WHISPER_LANGUAGE=es

# Imagen del clasificador: 1 instala Laya + torch (más pesada), 0 solo Jev/reglas.
WITH_LAYA=1

# Consola C++ ejecutada fuera de Docker
CLASIFICADOR_URL=http://127.0.0.1:8100
PROVEEDOR_CLASIFICACION=laya
DIRECTORIO_AUDIOS=audios

# Puerto del clasificador en el host. Cámbialo si el 8100 está ocupado.
CLASIFICADOR_PUERTO=8100
